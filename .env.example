# Evidence-Graph AI Auditor — environment reference
# Copy to `.env` at the repository root (or export the variables in your shell).
# Every variable is optional: the application starts with sensible local defaults.
# Prefix: all settings use EGA_.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | staging | production
EGA_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
EGA_LOG_LEVEL=INFO
# Additional origins allowed to call the API from a browser (comma-separated).
EGA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reject non-HTTPS requests. Turn on behind a TLS-terminating proxy.
EGA_REQUIRE_HTTPS=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Paths below are resolved from the directory you start uvicorn in (the repo root in the
# quick-start instructions). The application's own defaults use backend/data/; set these only
# if you want a different location.
# SQLite (default, zero setup):
EGA_DATABASE_URL=sqlite:///./data/auditor.db
# PostgreSQL for a shared deployment (embeddings still live in a JSON column; the vector
# extension is installed in the compose image but is not yet used for ANN search), e.g.:
# EGA_DATABASE_URL=postgresql+psycopg://ega:ega@localhost:5432/ega
# Create/upgrade schema automatically at startup (Alembic is the durable path).
EGA_AUTO_CREATE_SCHEMA=true

# Where uploads, generated reports and the SQLite file live.
EGA_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Frontend serving
# ---------------------------------------------------------------------------
# true  -> FastAPI serves the static Next.js export from EGA_FRONTEND_DIR (default)
# false -> API only; run `npm run dev` in frontend/ and point it at the API
EGA_SERVE_FRONTEND=true
EGA_FRONTEND_DIR=../frontend/out

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# Seeds the deterministic synthetic workspace on first start (development only).
EGA_SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production: the app refuses to start if this is unset or left at the placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Also derives the key that encrypts provider API keys at rest, so changing it invalidates
# stored provider credentials.
EGA_SECRET_KEY=change-me-in-production
# Access-token lifetime in minutes.
EGA_JWT_TTL_MINUTES=480
# Requests per minute per client for the general API limiter / the auth limiter.
EGA_API_RATE_LIMIT_PER_MINUTE=600
EGA_AUTH_RATE_LIMIT_PER_MINUTE=20
# Allow provider base URLs that resolve to private ranges (Ollama on localhost, LAN gateways).
# Keep false in shared deployments to block SSRF.
EGA_ALLOW_LOCAL_PROVIDER_URLS=false
# Upload guard rails.
EGA_MAX_UPLOAD_MB=25
EGA_MAX_PDF_PAGES=250
EGA_MAX_ZIP_FILES=5000

# ---------------------------------------------------------------------------
# Retrieval / embeddings
# ---------------------------------------------------------------------------
# Dimension used by the built-in deterministic hashing embedder (offline mode).
EGA_EMBEDDING_DIM=256

# ---------------------------------------------------------------------------
# Graph store
# ---------------------------------------------------------------------------
# The application is wired to the in-process networkx projection over persisted graph rows.
# `Neo4jGraphStore` in app/services/graph_store.py is an adapter stub (projection query and
# connection only); there is no runtime switch, so no graph setting is exposed here.
